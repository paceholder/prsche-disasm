                if(!old_imports[i]||!VirtualProtect(import_cells[i],4,PAGE_READWRITE,&old))die("protect");
                *import_cells[i]=import_values[i];if(!VirtualProtect(import_cells[i],4,old,&ignored))die("protect-mode");seen[i]=true;
            }
        }
    }for(bool found:seen)if(!found)die("missing-exact-import");
}
