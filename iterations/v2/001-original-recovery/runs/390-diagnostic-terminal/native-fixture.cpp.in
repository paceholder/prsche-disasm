    const char* dlls[4]={"KERNEL32.dll","USER32.dll","KERNEL32.dll","KERNEL32.dll"};
    const char* names[4]={"OutputDebugStringA","MessageBoxA","LoadLibraryA","GetProcAddress"};bool seen[4]{};
    auto* desc=reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base+nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT].VirtualAddress);
    for(;desc->Name;++desc){if(!desc->OriginalFirstThunk)die("original-thunks");
        auto* name=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->OriginalFirstThunk);
        auto* iat=reinterpret_cast<IMAGE_THUNK_DATA32*>(base+desc->FirstThunk);
        for(;name->u1.AddressOfData;++name,++iat){if(IMAGE_SNAP_BY_ORDINAL32(name->u1.Ordinal))continue;
            auto* item=reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base+name->u1.AddressOfData);
            for(U i=0;i<4;++i)if(!_stricmp(reinterpret_cast<const char*>(base+desc->Name),dlls[i])&&!std::strcmp(reinterpret_cast<const char*>(item->Name),names[i])){
