static U ptr(const void* p){return static_cast<U>(reinterpret_cast<std::uintptr_t>(p));}
static U word(const void* p){U v;std::memcpy(&v,p,4);return v;}
static void put(void* p,U v){std::memcpy(p,&v,4);}
static I srel(const B* p){I v;std::memcpy(&v,p,4);return v;}
static void die(const char* why,U detail=0){std::printf("fixture %s %08x\n",why,detail);std::fflush(stdout);ExitProcess(98);}
struct Event{U kind,a,b,c,d,e;};
static Event events[24];static U event_count;
static void record(U kind,U a=0,U b=0,U c=0,U d=0,U e=0){
    if(event_count>=24)die("event-overflow");
    Event& v=events[event_count++];v={};v.kind=kind;v.a=a;v.b=b;v.c=c;v.d=d;v.e=e;
}
// Case configuration: every endpoint below is driven only by this state.
struct Config{
    U line,call;
    U module_initial,answer_cache_initial,dealloc_cache_initial;
    U load_result,proc_answer,proc_dealloc;
    U status_result,target_result,target_effect;
    U getid_mode,getid_offset,getid_fail_bits,config_value;
};
static Config cfg;
static B arena[512];
